#!/usr/bin/env python3
import glob
import os
import re
import time
from typing import Dict, List, Tuple

import cflib
from cflib.crazyflie import Crazyflie
from cflib.crazyflie.syncCrazyflie import SyncCrazyflie
from cflib.crazyflie.swarm import Swarm, CachedCfFactory

# ==================================================
# USER CONFIG
# ==================================================

CSV_DIR = r"C:\Users\sfy0002\Documents\CSV_dir"
# Each CSV = one STEP
# Each CSV has 6 rows (x,y)
# Row order MUST match DRONES below

DRONES = [
    "cf1", "cf2",
    "cf3", "cf4",
    "cf5", "cf6",
]

# ---------- 3 CRAZYRADIOS, 2 DRONES EACH ----------
# Use 1M bitrate for reliability
URI_BY_DRONE = {
    # Radio 0 (USB index 0, channel 80)
    "cf1": "radio://0/80/1M/E7E7E7E701",
    "cf2": "radio://0/80/1M/E7E7E7E702",

    # Radio 1 (USB index 1, channel 90)
    "cf3": "radio://1/90/1M/E7E7E7E703",
    "cf4": "radio://1/90/1M/E7E7E7E704",

    # Radio 2 (USB index 2, channel 100)
    "cf5": "radio://2/100/1M/E7E7E7E705",
    "cf6": "radio://2/100/1M/E7E7E7E706",
}

# ---------- FLIGHT CONSTANTS ----------
FIXED_Z = 0.5
FIXED_YAW = 0.0
TAKEOFF_DURATION = 2.0
MOVE_DURATION = 2.0
LAND_Z = 0.0
LAND_DURATION = 2.0
START_DELAY = 5.0

# ==================================================
# CSV PARSING
# ==================================================

_number_re = re.compile(r"(\d+)")

def natural_key(path):
    parts = _number_re.split(os.path.basename(path))
    return [int(p) if p.isdigit() else p.lower() for p in parts]

def parse_step_csv(path: str, drones: List[str]) -> Dict[str, Tuple[float, float]]:
    with open(path) as f:
        lines = [l.strip() for l in f if l.strip() and not l.strip().startswith("#")]

    def parse_xy(line):
        try:
            x, y = line.split(",")
            return float(x), float(y)
        except Exception:
            return None

    start_idx = 1 if parse_xy(lines[0]) is None else 0

    rows = []
    for l in lines[start_idx:]:
        xy = parse_xy(l)
        if xy is not None:
            rows.append(xy)

    if len(rows) < len(drones):
        raise ValueError(
            f"{os.path.basename(path)} has {len(rows)} rows, expected {len(drones)}"
        )

    return {drones[i]: rows[i] for i in range(len(drones))}

def load_steps(csv_dir, drones):
    paths = sorted(glob.glob(os.path.join(csv_dir, "*.csv")), key=natural_key)
    if not paths:
        raise FileNotFoundError("No CSV step files found")
    return [parse_step_csv(p, drones) for p in paths]

def build_timelines(steps, drones):
    timelines = {d: [] for d in drones}
    for step in steps:
        for d in drones:
            timelines[d].append(step[d])
    return timelines

# ==================================================
# FLIGHT CONTROL
# ==================================================

def setup_high_level(cf: Crazyflie):
    cf.param.set_value("commander.enHighLevel", "1")
    try:
        cf.high_level_commander.stop()
    except Exception:
        pass
    time.sleep(0.1)

def fly_sequence(scf: SyncCrazyflie, waypoints, t0):
    cf = scf.cf
    hl = cf.high_level_commander
    setup_high_level(cf)

    hl.takeoff(FIXED_Z, TAKEOFF_DURATION)
    time.sleep(TAKEOFF_DURATION + 0.3)

    if time.time() < t0:
        time.sleep(t0 - time.time())

    for i, (x, y) in enumerate(waypoints, start=1):
        print(f"[{cf.link_uri}] STEP {i}: x={x:.2f}, y={y:.2f}")
        hl.go_to(x, y, FIXED_Z, FIXED_YAW, MOVE_DURATION, relative=False)
        time.sleep(MOVE_DURATION + 0.05)

    hl.land(LAND_Z, LAND_DURATION)
    time.sleep(LAND_DURATION + 0.2)
    hl.stop()

# ==================================================
# MAIN
# ==================================================

def main():
    cflib.crtp.init_drivers(enable_debug_driver=False)

    steps = load_steps(CSV_DIR, DRONES)
    timelines = build_timelines(steps, DRONES)

    print(f"Loaded {len(steps)} steps")
    for d in DRONES:
        print(f"{d}: {timelines[d]}")

    uris = [URI_BY_DRONE[d] for d in DRONES]
    uri_to_drone = {URI_BY_DRONE[d]: d for d in DRONES}

    factory = CachedCfFactory(rw_cache=None, ro_cache=None)

    t0 = time.time() + START_DELAY
    print(f"Swarm starting at t0 = {t0:.2f}")

    def task(scf: SyncCrazyflie):
        drone_id = uri_to_drone[scf.cf.link_uri]
        fly_sequence(scf, timelines[drone_id], t0)

    with Swarm(uris, factory=factory) as swarm:
        swarm.parallel_safe(task)

if __name__ == "__main__":
    main()